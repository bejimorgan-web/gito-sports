{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "skipLibCheck": true,

    "outDir": "dist",
    "rootDir": "src",

    "types": ["node"],

    "esModuleInterop": true,
    "resolveJsonModule": true,

    "noUncheckedIndexedAccess": true
  },
  "references": [{ "path": "../../packages/shared" }],
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/services/iptv-test-environment.ts"]
}